{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": ".test-build",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/engine/**/*.ts",
    "lib/game/**/*.ts",
    "lib/app/**/*.ts",
    "tests/**/*.ts"
  ]
}